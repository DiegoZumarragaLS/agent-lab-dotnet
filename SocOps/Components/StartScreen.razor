<div class="flex flex-col items-center justify-center min-h-full p-6">
    <div class="corporate-shell corporate-hero w-full max-w-md text-center">
        <div class="relative flex flex-col gap-6">
            <div>
                <span class="corporate-kicker mb-4">Soc Ops</span>
                <h1 class="text-4xl font-bold text-gray-900 mb-3 leading-tight">Corporate Social Bingo</h1>
                <p class="text-lg text-gray-600 mx-auto" style="max-width: 24rem;">
                    A clean, executive interface for team icebreakers, workshops, and onboarding sessions.
                </p>
            </div>

            <div class="corporate-card p-5 text-left">
                <h2 class="font-semibold text-gray-800 mb-4">How it works</h2>
                <div class="corporate-feature-list">
                    <div class="corporate-feature">
                        <span class="corporate-dot"></span>
                        <div>
                            <div class="font-semibold text-gray-900">Find a match</div>
                            <div class="text-sm text-gray-600">Scan the room for someone who fits each prompt.</div>
                        </div>
                    </div>
                    <div class="corporate-feature">
                        <span class="corporate-dot"></span>
                        <div>
                            <div class="font-semibold text-gray-900">Mark the square</div>
                            <div class="text-sm text-gray-600">Tap it once you confirm the answer.</div>
                        </div>
                    </div>
                    <div class="corporate-feature">
                        <span class="corporate-dot"></span>
                        <div>
                            <div class="font-semibold text-gray-900">Complete the line</div>
                            <div class="text-sm text-gray-600">Build a full row, column, or diagonal to win.</div>
                        </div>
                    </div>
                </div>
            </div>

            <button
                @onclick="OnStart"
                class="corporate-cta py-4 px-8 text-lg transition-all">
                Start session
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
