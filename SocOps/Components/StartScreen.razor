@using SocOps.Models

<div class="start-shell">
    <section class="corporate-shell start-hero">
        <div class="start-copy">
            <span class="corporate-kicker mb-4">Soc Ops</span>
            <h1 class="start-title">Pick a way to break the ice.</h1>
            <p class="start-copy__body">
                Launch a classic bingo board, a checklist sprint, or a one-tap card draw for fast discussion starters.
            </p>

            <div class="start-pills" aria-hidden="true">
                <span>Bingo</span>
                <span>Checklist</span>
                <span>Card Draw</span>
            </div>
        </div>

        <div class="start-preview" aria-hidden="true">
            <div class="start-card start-card--rear"></div>
            <div class="start-card start-card--middle"></div>
            <div class="start-card start-card--front">
                <span>Tap</span>
                <strong>Draw a prompt</strong>
            </div>
        </div>
    </section>

    <section class="start-mode-grid">
        <button @onclick="() => OnModeSelected.InvokeAsync(GameMode.Bingo)" class="start-mode-card">
            <span class="start-mode-card__label">Classic</span>
            <strong>Bingo</strong>
            <span>Match prompts across a 5x5 board.</span>
        </button>

        <button @onclick="() => OnModeSelected.InvokeAsync(GameMode.ScavengerHunt)" class="start-mode-card">
            <span class="start-mode-card__label">Checklist</span>
            <strong>Scavenger Hunt</strong>
            <span>Track quick wins with a simple progress list.</span>
        </button>

        <button @onclick="() => OnModeSelected.InvokeAsync(GameMode.CardDeck)" class="start-mode-card start-mode-card--deck">
            <span class="start-mode-card__label">New</span>
            <strong>Card Deck Shuffle</strong>
            <span>Tap once, flip a random card, and get a new question.</span>
        </button>
    </section>

    <section class="start-footer">
        <div class="start-footer__note">Built for mixers, workshops, and quick social rounds.</div>
    </section>
</div>

@code {
    [Parameter]
    public EventCallback<GameMode> OnModeSelected { get; set; }
}
