<div class="bingo-modal">
    <div class="bingo-dialog">
        <div class="bingo-dialog__badge">✓</div>
        <h2 class="bingo-dialog__title">Bingo line complete</h2>
        <p class="bingo-dialog__copy">You finished a full line. Keep going or reset the session for another round.</p>

        <button
            @onclick="OnDismiss"
            class="bingo-dialog__cta py-3 px-6 transition-colors">
            Keep playing
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
