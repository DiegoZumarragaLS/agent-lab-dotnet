@using SocOps.Models

<div class="game-shell">
    <header class="game-header">
        <button
            @onclick="OnReset"
            class="text-gray-500 text-sm px-3 py-1.5 rounded active:bg-gray-100">
            ← Back
        </button>

        <div class="game-brand text-center">
            <small>Soc Ops</small>
            <h1 class="font-bold text-gray-900">Social Bingo</h1>
        </div>

        <div class="game-status">Live session</div>
    </header>

    <div class="game-hint text-sm text-center">
        Tap a square when you confirm a match. The board saves your progress automatically.
    </div>

    @if (HasBingo)
    {
        <div class="game-callout text-center">
            Line complete. You have a bingo.
        </div>
    }

    <div class="board-shell">
        <div class="board-frame">
            <BingoBoard
                Board="@Board"
                WinningSquareIds="@WinningSquareIds"
                OnSquareClick="@OnSquareClick" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
